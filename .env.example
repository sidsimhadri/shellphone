# shellphone configuration
# Copy to ~/.shellphone/.env and fill in your values.

# ---------------------------------------------------------------------------
# Required — Slack tokens
# ---------------------------------------------------------------------------

# Bot token  (xoxb-...)  — from your Slack app's "OAuth & Permissions" page
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-level token (xapp-...)  — from "Basic Information" → App-Level Tokens
# Needs the connections:write scope (used for Socket Mode)
SLACK_APP_TOKEN=xapp-your-app-token-here

# ---------------------------------------------------------------------------
# Authorization
# ---------------------------------------------------------------------------

# Comma-separated Slack user IDs allowed to send commands (e.g. U12345,U67890).
# Find your user ID in Slack: Profile → ⋯ → Copy member ID.
# Leave empty to allow ALL workspace members (not recommended for production).
ALLOWED_USERS=

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------

# Minutes without a stop-hook before the bot posts a "session may be stuck" warning.
WATCHDOG_TIMEOUT_MINUTES=10

# Lines of terminal output to capture and post on stop.
CAPTURE_LINES=100
